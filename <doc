function toggleStyle(id) {
    if (state.selectedStyles.has(id)) {
        if (state.selectedStyles.size <= 1) {
            log("Vous devez garder au moins un style sélectionné.", "warn");
            return;
        }
        state.selectedStyles.delete(id);
    } else {
        state.selectedStyles.add(id);
    }
    renderStyleChips();
}

function getSelectedStyleObjects() {
    return Array.from(state.selectedStyles).map(id => STYLE_OPTIONS.find(s => s.id === id)).filter(Boolean);
}

