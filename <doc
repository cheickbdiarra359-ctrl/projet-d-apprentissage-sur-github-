function renderClips() {
    const grid = document.getElementById("clips-grid");
    grid.innerHTML = state.clips.map((c, i) => {
        let icon = "◌", timer = "--", statusText = "En attente";
        if (c.status === "pending") { icon = "◌"; timer = "Prêt"; statusText = "File d'attente"; }
        else if (c.status === "processing") { icon = "◐"; timer = c.timerDisplay || "0s"; statusText = c.statusText || "Génération…"; }
        else if (c.status === "done") { icon = "●"; timer = "✓"; statusText = "Terminé"; }
        else if (c.status === "failed") { icon = "✕"; timer = "—"; statusText = "Échec"; }
        return `
            <div class="clip-card ${c.status}">
                <div class="clip-number">Clip ${i + 1}</div>
                <div class="clip-title">${esc(c.title || "")}</div>
                <div class="clip-icon">${icon}</div>
                <div class="clip-timer">${timer}</div>
                <div class="clip-status-text">${statusText}</div>
            </div>
        `;
    }).join("");
}
function updateClip(index, updates) {
    Object.assign(state.clips[index], updates);
    renderClips();
}

