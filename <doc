async function loadHistory() {
    try {
        const videos = await getAllVideosFromDB();
        const emptyEl = document.getElementById("history-empty");
        const gridEl = document.getElementById("history-grid");
        if (!videos.length) { emptyEl.style.display = "block"; gridEl.innerHTML = ""; return; }
        emptyEl.style.display = "none";
        videos.sort((a, b) => b.timestamp - a.timestamp);
        gridEl.innerHTML = videos.map(v => `
            <div class="history-item">
                <video controls preload="metadata" muted playsinline>
                    <source src="${v.url}" type="video/mp4">
                </video>
                <div class="history-meta">
                    <span class="style">${esc(v.style || "")}</span><br>
                    ${esc(v.filmTitle || "")}<br>
                    ${new Date(v.timestamp).toLocaleString()}
                </div>
            </div>
        `).join("");
    } catch (e) { console.error("Historique :", e); }
}

// ==================================================================
// UPLOAD IMAGE
// ==================================================================
const uploadArea = document.getElementById("upload-area");
const fileInput = document.getElementById("file-input");
const previewThumb = document.getElementById("preview-thumb");

uploadArea.addEventListener("click", () => fileInput.click());
uploadArea.addEventListener("dragover", (e) => { e.preventDefault(); uploadArea.classList.add("dragover"); });
uploadArea.addEventListener("dragleave", () => uploadArea.classList.remove("dragover"));
uploadArea.addEventListener("drop", (e) => {
    e.preventDefault(); uploadArea.classList.remove("dragover");
    if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
});
fileInput.addEventListener("change", (e) => {
    if (e.target.files.length) handleFile(e.target.files[0]);
});

async function handleFile(file) {
    if (!file.type.startsWith("image/")) { alert("Fichier non image."); return; }
    if (file.size > 10 * 1024 * 1024) { alert("Image trop lourde (max 10 MB)."); return; }
    try {
        const dataUri = await fileToDataUri(file);
        state.referenceImageDataUri = dataUri;
        previewThumb.src = dataUri;
        previewThumb.classList.add("visible");
        log(`Photo de référence chargée (${(file.size / 1024).toFixed(0)} Ko) — mode keyframe activé.`, "ok");
    } catch (err) { alert("Erreur : " + err.message); }
}

function clearImage() {
    state.referenceImageDataUri = null;
    fileInput.value = "";
    previewThumb.src = "";
    previewThumb.classList.remove("visible");
    log("Photo de référence retirée — mode text-to-video.", "");
}

function resetToPhase1() {
    state.isRunning = false;
    setPhase(1);
    showCooldown("cooldown-badge", 0);
}

document.getElementById("dance-style").addEventListener("change", (e) => {
    document.getElementById("custom-dance-row").style.display = e.target.value === "custom" ? "flex" : "none";
});

