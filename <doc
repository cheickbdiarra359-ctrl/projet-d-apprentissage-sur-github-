// ==================================================================
async function startGeneration() {
    if (state.isRunning) return;

    const scenario = document.getElementById("user-scenario").value.trim();
    if (!scenario) { showError("Décris d'abord ton sujet / scénario."); return; }

    const characterDesc = document.getElementById("character-desc").value.trim();
    const danceKey = document.getElementById("dance-style").value;
    const customDance = document.getElementById("custom-dance").value.trim();

    if (danceKey === "custom" && !customDance) {
        showError("Décris ton style de mouvement personnalisé.");
        return;
    }

    if (state.selectedStyles.size === 0) {
        showError("Sélectionnez au moins un style visuel.");
        return;
    }

    state.scenario = scenario;
    state.characterDesc = characterDesc;
    state.danceStyleKey = danceKey;
    state.customDance = customDance;

    const btn = document.getElementById("start-btn");
    btn.disabled = true;
    state.isRunning = true;

    clearError();
    document.getElementById("log-box").innerHTML = "";
    document.getElementById("video-grid").innerHTML = "";
    document.getElementById("clips-grid").innerHTML = "";
    document.getElementById("bible-content").innerHTML = "";
    document.getElementById("scenes-content").innerHTML = "";

    setPhase(2);
    document.getElementById("bible-panel").classList.remove("visible");
    document.getElementById("scenes-panel").classList.remove("visible");
    document.getElementById("gallery-panel").classList.remove("visible");
    document.getElementById("gallery-title").textContent = "✦ Vos clips apparaîtront ici ✦";
    document.getElementById("progress-panel").classList.add("visible");

    state.bible = null;
    state.scenes = [];
    state.clips = [];

    const selectedStyles = getSelectedStyleObjects();

    try {
        log("🎬 Démarrage du workflow", "hl");
        log(`Styles sélectionnés : ${selectedStyles.map(s => s.name).join(", ")}`, "ok");
        log(`Mouvement : ${danceKey}`, "");
        log(`Photo de référence : ${state.referenceImageDataUri ? "oui (mode keyframe)" : "non (text-to-video)"}`, "");

        // ══════════ ÉTAPE A : BIBLE ══════════
        setStatus("global-status-text", "L'agent écrit la bible du film…");
        log("━━━ Génération de la bible ━━━", "hl");
        const bible = await generateBible(state.scenario, state.characterDesc, selectedStyles);
        state.bible = bible;
        renderBible(bible);
        log(`Titre : ${bible.film_title}`, "ok");
        log(`Personnages : ${bible.characters.map(c => c.name).join(", ")}`, "ok");

        // Pause inter-appel
        log("Pause de 3s avant la génération des scènes…", "");
        await sleep(3000);

        // ══════════ ÉTAPE B : SCÈNES ══════════
        setStatus("global-status-text", "L'agent écrit les 11 scènes…");
        log("━━━ Génération des 11 scènes ━━━", "hl");
        const scenes = await generateScenes(bible, state.scenario, selectedStyles, state.danceStyleKey, state.customDance);
        state.scenes = scenes;
        renderScenes(scenes);
        log(`${scenes.length} scènes générées.`, "ok");

        // Init clips
        state.clips = scenes.map((s, i) => ({
            id: i + 1,
            title: s.title,
            status: "pending",
            timerDisplay: "--",
            statusText: "File d'attente",
            videoUrl: null,
            videoId: null,
            dialogue: s.dialogue,
            dialogue_speaker: s.dialogue_speaker,
            prompt: s.video_prompt || "",
            director: s.director_style || ""
        }));
        renderClips();

        // ══════════ ÉTAPE C : PAUSE PRÉ-VIDÉO ══════════
        log(`Pause de ${PRE_VIDEO_DELAY_MS / 1000}s avant le premier clip…`, "warn");
        await countdown(Math.floor(PRE_VIDEO_DELAY_MS / 1000), "global-status-text", "cooldown-badge", "⏸ Pause pré-vidéo");

        // ══════════ ÉTAPE D : GÉNÉRATION DES 11 CLIPS ══════════
        let successCount = 0;

        for (let i = 0; i < scenes.length; i++) {
            if (!state.isRunning) break;
            const s = scenes[i];

            log(`━━━━ Clip ${i + 1}/${scenes.length} — ${s.title} (${s.director_style}) ━━━━`, "hl");
            setStatus("global-status-text", `Clip ${i + 1}/${scenes.length} : création…`);

            let videoId;
            try {
                updateClip(i, { status: "processing", statusText: "Création tâche…" });

                const body = {
                    model: MODELS.video,
                    prompt: s.video_prompt,
                    num_frames: FILM_NUM_FRAMES,
                    frame_rate: FRAME_RATE
                };
                // Mode keyframe si image de référence
                if (state.referenceImageDataUri) {
                    body.image = state.referenceImageDataUri;
                    body.mode = "keyframes";
                }

                const res = await apiFetch(`${BASE_URL}/videos`, {
                    method: "POST", headers: apiHeaders(), body: JSON.stringify(body)
                }, `Clip ${i + 1} · Création`, "video");

                const data = await res.json();
                if (!res.ok) throw new Error(data.error?.message || `HTTP ${res.status}`);
                videoId = data.video_id || data.id || data.task_id;
                if (!videoId) throw new Error("Pas de video_id retourné.");

                log(`Clip ${i + 1} : tâche créée (${String(videoId).slice(0, 30)}…)`, "ok");
                updateClip(i, { videoId, statusText: "Attente initiale" });

            } catch (err) {
                log(`Clip ${i + 1} : échec création — ${err.message}`, "err");
                updateClip(i, { status: "failed", statusText: "Échec création" });
                if (i < scenes.length - 1 && state.isRunning) {
                    await countdown(Math.floor(INTER_VIDEO_DELAY_MS / 1000), "global-status-text", "cooldown-badge", "⏸ Pause inter-clip");
                }
                continue;
            }

            try {
                const url = await pollVideo(videoId, `Clip ${i + 1}`);
                updateClip(i, { status: "done", videoUrl: url, timerDisplay: "✓", statusText: "Terminé" });
                addVideoToGallery(i, url, s.title, s.dialogue, s.dialogue_speaker, s.director_style);
                document.getElementById("gallery-panel").classList.add("visible");
                successCount++;

                try {
                    await saveVideoToDB({
                        url, style: s.director_style || "",
                        filmTitle: bible.film_title,
                        sceneTitle: s.title, prompt: s.video_prompt,
                        dialogue: s.dialogue || "",
                        timestamp: Date.now()
                    });
                    log(`Clip ${i + 1} : sauvegardé.`, "ok");
                } catch (dbErr) { log(`Clip ${i + 1} : erreur DB — ${dbErr.message}`, "warn"); }
            } catch (err) {
                log(`Clip ${i + 1} : ${err.message}`, "err");
                updateClip(i, { status: "failed", statusText: "Échec génération" });
            }

            if (i < scenes.length - 1 && state.isRunning) {
                log(`Pause de ${INTER_VIDEO_DELAY_MS / 1000}s avant le clip suivant…`, "warn");
                await countdown(Math.floor(INTER_VIDEO_DELAY_MS / 1000), "global-status-text", "cooldown-badge", "⏸ Pause inter-clip");
            }
        }

        // ══════════ BILAN ══════════
        if (successCount > 0) {
            setStatus("global-status-text", `✦ ${successCount}/${scenes.length} clips générés — « ${bible.film_title} » ✦`);
            log(`Workflow terminé — ${successCount}/${scenes.length}.`, "ok");
            await loadHistory();
        } else {
            setStatus("global-status-text", "Aucune vidéo générée.");
            showError("Toutes les générations ont échoué.");
        }

    } catch (err) {
        log(`Erreur film : ${err.message}`, "err");
        showError(err.message);
        setStatus("global-status-text", "Erreur : " + err.message);
    } finally {
        state.isRunning = false;
        btn.disabled = false;
        showCooldown("cooldown-badge", 0);
    }
}

