function setPhase(n) {
    document.querySelectorAll(".phase-dot").forEach((d, i) => {
        d.classList.remove("active", "done");
        if (i + 1 < n) d.classList.add("done");
        else if (i + 1 === n) d.classList.add("active");
    });
    document.getElementById("phase-1").classList.toggle("visible", n === 1);
    document.getElementById("phase-2").classList.toggle("visible", n === 2);
}

async function countdown(seconds, statusId, badgeId, label) {
    for (let s = seconds; s > 0; s--) {
        if (!state.isRunning) throw new Error("Annulé");
        setStatus(statusId, `${label} (${s}s)`);
        showCooldown(badgeId, s);
        await sleep(1000);
    }
    showCooldown(badgeId, 0);
}

/**
 * Attendre que le quota soit disponible pour un type donné.
 * Utilise le sliding window pour calculer le temps d'attente exact.
 */
async function waitForQuota(type, statusId, badgeId, label) {
    while (!quotaTracker.canProceed(type)) {
        const wait = quotaTracker.waitTime(type);
        if (wait <= 0) break;
        log(`⏸ Quota ${type} saturé. Attente de ${wait}s…`, "warn");
        await countdown(wait, statusId, badgeId, label || `⏸ Quota ${type}`);
    }
}

// ==================================================================
// API FETCH — Gestion 429 + Erreurs réseau + Quota tracking
// ==================================================================
async function apiFetch(url, options = {}, label = "API", type = null) {
    let rateLimitAttempt = 0;
    let networkAttempt = 0;

    // Attendre le quota avant l'appel
    if (type) {
        await waitForQuota(type, "global-status-text", "cooldown-badge");
    }

    while (true) {
        let res;
        try {
            res = await fetch(url, options);
        } catch (netErr) {
            if (networkAttempt >= MAX_NETWORK_RETRIES) {
                log(`${label} : erreur réseau persistante.`, "err");
                throw new Error(`Erreur réseau : ${netErr.message}`);
            }
            const waitSec = NETWORK_ERROR_BACKOFF_SEC[networkAttempt] || 60;
            log(`⚠️ ${label} : ERREUR RÉSEAU. Retry ${networkAttempt + 1}/${MAX_NETWORK_RETRIES} dans ${waitSec}s…`, "warn");
            try {
                await countdown(waitSec, "global-status-text", "cooldown-badge", "🔌 Erreur réseau");
            } catch (e) { throw new Error("Annulé pendant le retry réseau"); }
            networkAttempt++;
            continue;
        }

        networkAttempt = 0;

        if (res.status !== 429) {
            // Enregistrer le succès dans le quota tracker
            if (type) quotaTracker.record(type);
            return res;
        }

        if (rateLimitAttempt >= MAX_RATE_LIMIT_RETRIES) {
            log(`${label} : rate limit persistant.`, "err");
            return res;
        }
        const waitSec = RATE_LIMIT_BACKOFF_SEC[rateLimitAttempt] || 15;
        log(`⚠️ ${label} : RATE LIMIT 429. Attente ${waitSec}s… (${rateLimitAttempt + 1}/${MAX_RATE_LIMIT_RETRIES + 1})`, "warn");
        try {
            await countdown(waitSec, "global-status-text", "cooldown-badge", "⏸ Rate limit");
        } catch (e) { throw new Error("Annulé pendant le cooldown"); }
        rateLimitAttempt++;
    }
}

