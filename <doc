Return ONLY this JSON. No scenes yet.`;

    log("Appel texte 1/2 — Bible…", "");
    const res = await apiFetch(`${BASE_URL}/chat/completions`, {
        method: "POST", headers: apiHeaders(),
        body: JSON.stringify({
            model: MODELS.text,
            messages: [
                { role: "system", content: systemPrompt },
                { role: "user", content: `Crée la bible pour ce film : ${scenario}` }
            ],
            temperature: 0.85,
            max_tokens: 2500
        })
    }, "Texte 1/2 · Bible", "text");

    const data = await res.json();
    if (!res.ok) throw new Error(data.error?.message || `HTTP ${res.status}`);

    let content = data.choices?.[0]?.message?.content || "";
    content = content.replace(/```json\s*/gi, "").replace(/```\s*/g, "").trim();
    const start = content.indexOf("{"); const end = content.lastIndexOf("}");
    if (start >= 0 && end > start) content = content.slice(start, end + 1);

    let parsed;
    try { parsed = JSON.parse(content); }
    catch (e) { throw new Error("JSON de la bible invalide."); }
    if (!parsed.bible) throw new Error("Structure de la bible invalide.");

    return parsed.bible;
}

// ==================================================================
// GÉNÉRATION ÉTAPE B — LES 11 SCÈNES
// ==================================================================
async function generateScenes(bible, scenario, selectedStyles, danceKey, customDance) {
    const danceDesc = danceKey === "custom" ? customDance : DANCE_STYLES[danceKey];
    const styleNames = selectedStyles.map(s => s.name).join(", ");
    const styleClusters = selectedStyles.map(s => `[${s.name}]: ${s.cluster}`).join("\n");

    const bibleBlock = `
FILM TITLE: ${bible.film_title}
LOGLINE: ${bible.logline}
TONE: ${bible.tone}
COLOR PALETTE: ${bible.color_palette}
WORLD: ${bible.world}
VISUAL STYLE ANCHOR (copy verbatim in every prompt): "${bible.visual_style_anchor}"
CHARACTERS (copy the exact "appearance" verbatim when a character is present):
${bible.characters.map(c => `- ${c.name} (${c.role}): ${c.appearance}`).join("\n")}
`;

    const systemPrompt = `You are an award-winning film director. You have already written the FILM BIBLE. Now you must write the DECOUPAGE into exactly 11 sequential scenes, one for each video clip (~6.4 seconds).

ORIGINAL IDEA: ${scenario}

BIBLE:
${bibleBlock}

SELECTED VISUAL STYLES: ${styleNames}
STYLE CLUSTERS:
${styleClusters}

MOVEMENT STYLE (applies to ALL characters in ALL scenes): ${danceDesc}

STRUCTURE — three acts for 11 scenes:
- ACT I (Scenes 1-3): Setup
- ACT II (Scenes 4-8): Development / rising tension
- ACT III (Scenes 9-11): Resolution

RULES:
1. EVERY scene must have dialogue in FRENCH, literary but alive, max 20 words. No "Aucun dialogue".
2. SOUND: ONLY minimal foley + soft ambient. NO MUSIC.
3. Every scene must include characters performing: ${danceDesc}.
4. Each "video_prompt" MUST follow this skeleton (in English, under 900 chars):
   [VISUAL STYLE ANCHOR verbatim] + [WORLD verbatim] + [CHARACTERS with verbatim appearances] + [LOCATION] + [ACTION with dance movement] + [SHOT] + [LIGHTING] + [MOOD & SOUND] + [Tail: "cinematic, 9:16 vertical, 24fps, consistent character design"].
5. Assign a director_style to each scene. Distribute the selected styles (${styleNames}) across the 11 scenes.

OUTPUT — a single valid JSON object, no commentary, no markdown fences:
{
  "scenes": [
    {
      "scene_number": 1,
      "act": 1,
      "title": "string (in French)",
      "characters_present": ["name1", "name2"],
      "location": "string",
      "narrative_beat": "string (in French, 1-2 sentences)",
      "dialogue": "string (in French)",
      "dialogue_speaker": "name or null",
      "shot_type": "string",
      "camera_movement": "string",
      "lighting": "string (in English)",
      "mood": "string (in French)",
      "sound_design": "string (in English, ONLY foley/ambient)",
      "director_style": "string (style name from selected styles)",
      "video_prompt": "English prompt following the skeleton, under 900 chars."
    }
  ]
}

Return EXACTLY 11 scenes.`;

    log("Appel texte 2/2 — Scènes…", "");
    const res = await apiFetch(`${BASE_URL}/chat/completions`, {
        method: "POST", headers: apiHeaders(),
        body: JSON.stringify({
            model: MODELS.text,
            messages: [
                { role: "system", content: systemPrompt },
                { role: "user", content: `Écris les 11 scènes du film.` }
            ],
            temperature: 0.85,
            max_tokens: 6000
        })
    }, "Texte 2/2 · Scènes", "text");

    const data = await res.json();
    if (!res.ok) throw new Error(data.error?.message || `HTTP ${res.status}`);

    let content = data.choices?.[0]?.message?.content || "";
    content = content.replace(/```json\s*/gi, "").replace(/```\s*/g, "").trim();
    const start = content.indexOf("{"); const end = content.lastIndexOf("}");
    if (start >= 0 && end > start) content = content.slice(start, end + 1);

    let parsed;
    try { parsed = JSON.parse(content); }
    catch (e) { throw new Error("JSON des scènes invalide."); }
    if (!Array.isArray(parsed.scenes)) throw new Error("Structure des scènes invalide.");

    parsed.scenes = parsed.scenes.slice(0, 11);
    while (parsed.scenes.length < 11) {
        const n = parsed.scenes.length + 1;
        const styleName = selectedStyles[n % selectedStyles.length].name;
        parsed.scenes.push({
            scene_number: n,
            act: n <= 3 ? 1 : (n <= 8 ? 2 : 3),
            title: `Scène ${n}`,
            characters_present: [],
            location: "scène",
            narrative_beat: "Scène de transition.",
            dialogue: "Le mouvement dit tout ce que les mots ne peuvent exprimer.",
            dialogue_speaker: null,
            shot_type: "wide shot",
            camera_movement: "slow pan",
            lighting: "natural light",
            mood: "contemplatif",
            sound_design: "soft wind, distant birds",
            director_style: styleName,
            video_prompt: `${bible.visual_style_anchor} ${bible.world} Action: contemplative dance movement. Shot: wide, slow pan. Lighting: natural. Sound: soft wind. cinematic, 9:16 vertical, 24fps, consistent character design.`
        });
    }

    return parsed.scenes;
}

// ==================================================================
// POLLING VIDÉO
// ==================================================================
async function pollVideo(videoId, label) {
    let remaining = Math.floor(FIRST_POLL_DELAY_MS / 1000);
    while (remaining > 0 && state.isRunning) {
        setStatus("global-status-text", `${label} : attente initiale… (${remaining}s)`);
        showCooldown("cooldown-badge", remaining);
        await sleep(1000);
        remaining--;
    }
    if (!state.isRunning) throw new Error("Annulé");

    for (let attempt = 0; attempt < MAX_POLL_ATTEMPTS; attempt++) {
        if (!state.isRunning) throw new Error("Annulé");
        if (attempt > 0) {
            let r = Math.floor(POLL_INTERVAL_MS / 1000);
            while (r > 0 && state.isRunning) {
                setStatus("global-status-text", `${label} : vérification ${attempt + 1}… (${r}s)`);
                showCooldown("cooldown-badge", r);
                await sleep(1000);
                r--;
            }
        }

        log(`${label} : vérification n°${attempt + 1}…`, "hl");
        const url = `${RAW_URL}/agnesapi?video_id=${encodeURIComponent(videoId)}&model_name=${encodeURIComponent(MODELS.video)}`;
        try {
            const r = await apiFetch(url, { method: "GET", headers: apiHeaders() }, `${label} · Poll`);
            const d = await r.json();
            const status = d.status || "unknown";
            const progress = d.progress ?? 0;
            log(`${label} : statut="${status}", progression=${progress}%`);
            setStatus("global-status-text", `${label} : ${progress}%`);

            if (status === "completed" || status === "succeeded") {
                const videoUrl = d.metadata?.url || d.url || d.output?.url;
                if (!videoUrl) throw new Error("Terminé mais pas d'URL.");
                log(`${label} : TERMINÉ !`, "ok");
                return videoUrl;
            }
            if (status === "failed" || status === "error")
                throw new Error("La génération a échoué.");
        } catch (err) {
            if (err.message.includes("échoué") || err.message.includes("URL")) throw err;
            log(`${label} : erreur polling (${err.message}), on réessaie…`, "warn");
        }
    }
    throw new Error("Délai maximal dépassé.");
}

