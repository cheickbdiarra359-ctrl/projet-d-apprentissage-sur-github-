<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CinéIA — Créez votre film de 1 minute 10</title>
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
        --bg: #0a0a0a; --panel: #151515; --panel-2: #1a1a1a; --border: #2a2a2a;
        --accent: #c4b5fd; --accent-dark: #a78bfa; --text: #e0e0e0; --text-dim: #888;
        --success: #4ade80; --error: #f87171; --warn: #facc15;
    }
    body { font-family: system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
        background: var(--bg); color: var(--text); min-height: 100vh; display: flex;
        flex-direction: column; align-items: center; padding: 2rem 1rem; }
    .container { max-width: 1300px; width: 100%; }
    header { text-align: center; margin-bottom: 2rem; }
    h1 { font-size: 2rem; font-weight: 300; letter-spacing: 0.05em; color: #f0f0f0; }
    .subtitle { color: var(--text-dim); font-size: 0.9rem; font-style: italic; margin-top: 0.3rem; }

    .settings-toggle { background: transparent; border: 1px solid var(--border);
        color: var(--text-dim); padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.8rem;
        cursor: pointer; margin-bottom: 1rem; }
    .settings-toggle:hover { border-color: var(--accent-dark); color: var(--accent); }
    .settings-panel { background: var(--panel); border: 1px solid var(--border);
        border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; display: none; }
    .settings-panel.visible { display: block; }
    .settings-row { display: flex; gap: 0.75rem; align-items: end; }
    .settings-hint { font-size: 0.75rem; color: var(--text-dim); margin-top: 0.5rem; }

    /* Quota bar */
    .quota-bar {
        background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
        padding: 0.9rem 1.2rem; margin-bottom: 1.5rem; display: flex; gap: 1.5rem;
        flex-wrap: wrap; align-items: center; font-size: 0.75rem;
    }
    .quota-item { display: flex; align-items: center; gap: 0.5rem; }
    .quota-item .label { color: var(--text-dim); }
    .quota-item .value { font-weight: 600; font-variant-numeric: tabular-nums; }
    .quota-item .value.ok { color: var(--success); }
    .quota-item .value.warn { color: var(--warn); }
    .quota-item .value.danger { color: var(--error); }
    .quota-bar .reset-info { margin-left: auto; color: var(--text-dim); font-size: 0.7rem; }

    .form-panel { background: var(--panel); border: 1px solid var(--border);
        border-radius: 16px; padding: 2rem; margin-bottom: 2rem; }
    .form-row { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .form-row > * { flex: 1; min-width: 180px; }
    label { display: block; font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.4rem;
        text-transform: uppercase; letter-spacing: 0.08em; }
    textarea, select, input[type="number"], input[type="password"], input[type="text"] {
        width: 100%; padding: 0.85rem 1rem; border-radius: 10px; border: 1px solid var(--border);
        background: #0f0f0f; color: var(--text); font-family: inherit; font-size: 0.95rem;
        transition: border-color 0.2s; }
    textarea { height: 100px; resize: vertical; min-height: 60px; }
    textarea:focus, select:focus, input:focus { outline: none; border-color: var(--accent-dark); }
    select option { background: #1a1a1a; color: var(--text); }

    .btn { padding: 1rem 2rem; background: var(--accent-dark); color: #0a0a0a; border: none;
        border-radius: 10px; font-size: 1rem; font-weight: 600; cursor: pointer;
        transition: background 0.2s, transform 0.1s; width: 100%; }
    .btn:hover:not(:disabled) { background: var(--accent); }
    .btn:active:not(:disabled) { transform: scale(0.98); }
    .btn:disabled { background: #333; color: #666; cursor: not-allowed; }
    .btn-secondary { background: #2a2a2a; color: var(--text); }
    .btn-secondary:hover:not(:disabled) { background: #3a3a3a; }
    .btn-small { padding: 0.6rem 1.2rem; font-size: 0.85rem; }

    .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 16px;
        padding: 1.5rem; margin-bottom: 1.5rem; display: none; }
    .panel.visible { display: block; }
    .panel-title { font-size: 0.8rem; color: var(--accent-dark); text-transform: uppercase;
        letter-spacing: 0.1em; margin-bottom: 1rem; font-weight: 600; }

    .status-line { font-size: 0.9rem; color: var(--accent-dark); margin-bottom: 1rem;
        display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .status-line .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-dark);
        animation: pulse 1.5s infinite; flex-shrink: 0; }
    @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
    .cooldown-badge { background: #3a2a15; color: var(--warn); padding: 0.2rem 0.6rem;
        border-radius: 6px; font-size: 0.75rem; font-weight: 600; }

    .bible-title { font-size: 1.6rem; font-weight: 300; color: #f0f0f0; margin-bottom: 0.3rem;
        font-style: italic; }
    .bible-logline { color: var(--text-dim); font-size: 0.9rem; margin-bottom: 1.2rem; }
    .bible-section { margin-bottom: 1rem; }
    .bible-section-title { font-size: 0.75rem; color: var(--accent); text-transform: uppercase;
        letter-spacing: 0.1em; margin-bottom: 0.4rem; font-weight: 600; }
    .character-card { background: var(--panel-2); border: 1px solid var(--border);
        border-radius: 10px; padding: 0.8rem; margin-bottom: 0.5rem; }
    .character-name { font-weight: 600; color: var(--accent); font-size: 0.9rem; }
    .character-role { font-size: 0.75rem; color: var(--text-dim); font-style: italic;
        margin-bottom: 0.3rem; }
    .character-appearance { font-size: 0.8rem; color: var(--text); line-height: 1.4; }
    .bible-text { font-size: 0.85rem; color: var(--text); line-height: 1.5; }

    .scene-item { background: var(--panel-2); border: 1px solid var(--border);
        border-left: 3px solid var(--accent-dark); border-radius: 10px; padding: 0.9rem;
        margin-bottom: 0.6rem; }
    .scene-header { display: flex; justify-content: space-between; align-items: baseline;
        margin-bottom: 0.3rem; }
    .scene-number { font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase;
        letter-spacing: 0.1em; }
    .scene-act { font-size: 0.65rem; color: var(--accent); background: #2a2035;
        padding: 0.15rem 0.5rem; border-radius: 4px; }
    .scene-title { font-size: 0.95rem; color: #f0f0f0; font-weight: 500; margin-bottom: 0.4rem; }
    .scene-beat { font-size: 0.82rem; color: var(--text); line-height: 1.4; margin-bottom: 0.5rem; }
    .scene-dialogue { font-size: 0.85rem; color: var(--accent); font-style: italic;
        padding-left: 0.8rem; border-left: 2px solid var(--accent-dark); margin-bottom: 0.4rem;
        line-height: 1.4; }
    .scene-meta { font-size: 0.7rem; color: var(--text-dim); display: flex; gap: 0.8rem;
        flex-wrap: wrap; }
    .scene-prompt { font-size: 0.7rem; color: #555; font-family: monospace;
        margin-top: 0.4rem; padding: 0.5rem; background: #0f0f0f; border-radius: 6px;
        line-height: 1.3; max-height: 100px; overflow-y: auto; }

    .clips-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 0.75rem; }
    .clip-card { background: #1a1a1a; border: 1px solid var(--border); border-radius: 12px;
        padding: 1rem; text-align: center; transition: border-color 0.3s, opacity 0.3s; }
    .clip-card.pending { opacity: 0.45; }
    .clip-card.processing { border-color: var(--accent-dark); }
    .clip-card.done { border-color: var(--success); }
    .clip-card.failed { border-color: var(--error); }
    .clip-number { font-size: 0.7rem; color: #666; text-transform: uppercase;
        letter-spacing: 0.1em; }
    .clip-title { font-size: 0.75rem; color: #ccc; margin-bottom: 0.4rem; min-height: 2em;
        line-height: 1.2; }
    .clip-icon { font-size: 1.4rem; margin-bottom: 0.3rem; }
    .clip-timer { font-size: 1.1rem; font-weight: 600; color: var(--text);
        font-variant-numeric: tabular-nums; }
    .clip-status-text { font-size: 0.68rem; color: var(--text-dim); margin-top: 0.2rem; }
    .clip-card.done .clip-timer { color: var(--success); }
    .clip-card.failed .clip-timer { color: var(--error); }

    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem; margin-top: 1rem; }
    .video-item { background: var(--panel-2); border-radius: 12px; overflow: hidden;
        border: 1px solid var(--border); animation: fadeIn 0.6s ease-in; }
    @keyframes fadeIn { from{opacity:0; transform:translateY(10px);}
        to{opacity:1; transform:translateY(0);} }
    .video-item video { width: 100%; display: block; aspect-ratio: 9/16; object-fit: cover;
        background: #000; }
    .video-caption { padding: 0.7rem 0.8rem; background: var(--panel); }
    .video-caption-title { font-size: 0.8rem; color: var(--accent); font-weight: 600;
        margin-bottom: 0.3rem; }
    .video-caption-dialogue { font-size: 0.78rem; color: #ddd; font-style: italic;
        padding-left: 0.6rem; border-left: 2px solid var(--accent-dark); line-height: 1.4; }

    .log-box { margin-top: 1rem; padding: 0.75rem; background: #0f0f0f; border-radius: 10px;
        border: 1px solid #222; font-family: ui-monospace, monospace; font-size: 0.7rem;
        color: #666; max-height: 220px; overflow-y: auto; display: none; }
    .log-box.visible { display: block; }
    .log-box div { padding: 1px 0; }
    .log-box .hl { color: var(--accent); }
    .log-box .ok { color: var(--success); }
    .log-box .err { color: var(--error); }
    .log-box .warn { color: var(--warn); }

    .error-box { background: #2a1515; border: 1px solid var(--error); border-radius: 10px;
        padding: 1rem; color: var(--error); font-size: 0.85rem; margin-top: 1rem; display: none; }
    .error-box.visible { display: block; }

    .history-section { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 2rem; }
    .history-title { font-size: 1.1rem; font-weight: 300; color: var(--accent-dark);
        margin-bottom: 1rem; }
    .history-empty { color: var(--text-dim); font-size: 0.85rem; font-style: italic; }
    .history-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.75rem; margin-top: 1rem; }
    .history-item { background: var(--panel); border: 1px solid var(--border);
        border-radius: 10px; overflow: hidden; }
    .history-item video { width: 100%; display: block; aspect-ratio: 9/16; object-fit: cover; }
    .history-meta { padding: 0.5rem; font-size: 0.7rem; color: var(--text-dim); line-height: 1.4; }
    .history-meta .style { color: var(--accent); font-weight: 600; }

    .upload-area { background: var(--panel); border: 2px dashed var(--border);
        border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem; text-align: center;
        cursor: pointer; transition: border-color 0.2s; }
    .upload-area:hover, .upload-area.dragover { border-color: var(--accent-dark); }
    .upload-area input[type="file"] { display: none; }
    .upload-icon { font-size: 2rem; margin-bottom: 0.5rem; }
    .upload-text { font-size: 0.9rem; color: var(--text); margin-bottom: 0.3rem; }
    .upload-hint { font-size: 0.7rem; color: var(--text-dim); }
    .preview-thumb { max-width: 100%; max-height: 150px; border-radius: 8px; margin-top: 0.6rem; display: none; }
    .preview-thumb.visible { display: block; margin: 0.6rem auto 0; }

    .phase-indicator { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; justify-content: center; }
    .phase-dot { width: 12px; height: 12px; border-radius: 50%; background: #333; transition: background 0.3s; }
    .phase-dot.active { background: var(--accent-dark); }
    .phase-dot.done { background: var(--success); }

    .info-banner { background: #2a2035; border-left: 3px solid var(--accent-dark);
        padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.82rem; color: var(--accent);
        margin-bottom: 1rem; }

    /* Styles selector chips */
    .style-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
    .style-chip { background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px;
        padding: 0.5rem 0.9rem; font-size: 0.8rem; cursor: pointer; transition: all 0.2s;
        user-select: none; }
    .style-chip:hover { border-color: var(--accent-dark); }
    .style-chip.selected { background: #2a2035; border-color: var(--accent-dark); color: var(--accent); font-weight: 600; }
</style>
</head>
<body>
<div class="container">
    <header>
        <h1>CinéIA</h1>
        <p class="subtitle">Créez votre film de 1 minute 10 — 11 clips · Styles prédéfinis · Photo de référence</p>
    </header>

    <button class="settings-toggle" onclick="document.getElementById('settings-panel').classList.toggle('visible')">
        ⚙️ Paramètres API
    </button>
    <div id="settings-panel" class="settings-panel">
        <div class="settings-row">
            <div style="flex:1;">
                <label for="api-key-input">Clé API Agnes AI</label>
                <input type="password" id="api-key-input" placeholder="sk-...">
            </div>
            <button class="btn" style="width:auto; padding:0.85rem 1.5rem;" onclick="saveApiKey()">Sauvegarder</button>
        </div>
        <p class="settings-hint">Stockée localement. Jamais envoyée ailleurs qu'à l'API Agnes AI.</p>
    </div>

    <!-- Quota bar -->
    <div class="quota-bar" id="quota-bar">
        <div class="quota-item">
            <span class="label">📝 Texte</span>
            <span class="value ok" id="quota-text">0/20</span>
            <span class="label">RPM</span>
        </div>
        <div class="quota-item">
            <span class="label">🖼️ Image</span>
            <span class="value ok" id="quota-image">0/20</span>
            <span class="label">RPM</span>
        </div>
        <div class="quota-item">
            <span class="label">🎬 Vidéo</span>
            <span class="value ok" id="quota-video">0/1</span>
            <span class="label">RPM</span>
        </div>
        <div class="reset-info" id="quota-reset-info">Fenêtre glissante 60s</div>
    </div>

    <div class="phase-indicator">
        <div class="phase-dot active" id="phase-dot-1" title="Configuration"></div>
        <div class="phase-dot" id="phase-dot-2" title="Génération du film"></div>
    </div>

    <!-- PHASE 1 -->
    <div id="phase-1" class="panel visible">
        <div class="panel-title">🎬 Étape 1 — Configurez votre film</div>
        <div class="form-panel" style="margin-bottom: 0;">
            <div class="form-row">
                <div style="flex:1 1 100%;">
                    <label for="user-scenario">Sujet / Scénario du film</label>
                    <textarea id="user-scenario" placeholder="Ex : Des chats extraterrestres maîtres de kung-fu débarquent sur Terre pour sauver les animaux d'un capitalisme dévoyé…"></textarea>
                </div>
            </div>
            <div class="form-row">
                <div style="flex:1 1 100%;">
                    <label for="character-desc">Description du personnage principal</label>
                    <textarea id="character-desc" placeholder="Ex : Un chat noir élégant, maître Shaolin, robe de moine usée, yeux dorés, posture toujours droite…"></textarea>
                </div>
            </div>
            <div class="form-row">
                <div style="flex:1 1 100%;">
                    <label>Photo de référence du personnage (optionnel mais recommandé)</label>
                    <div class="upload-area" id="upload-area">
                        <input type="file" id="file-input" accept="image/*">
                        <div class="upload-icon">🖼️</div>
                        <div class="upload-text">Cliquez ou glissez une photo ici</div>
                        <div class="upload-hint">PNG, JPG, WEBP — max 10 MB. Cette photo servira de première frame pour chaque clip (mode keyframe).</div>
                        <img id="preview-thumb" class="preview-thumb" alt="Aperçu">
                    </div>
                    <button class="btn btn-secondary btn-small" onclick="clearImage()" style="width:auto;">Retirer l'image</button>
                </div>
            </div>
            <div class="form-row">
                <div style="flex:1 1 100%;">
                    <label>Styles visuels (sélectionnez 1 ou plusieurs)</label>
                    <div class="style-chips" id="style-chips"></div>
                </div>
            </div>
            <div class="form-row">
                <div style="flex:1 1 100%;">
                    <label for="dance-style">Style de mouvement / danse</label>
                    <select id="dance-style">
                        <option value="shaolin">🥋 Kung-fu Shaolin (mouvements fluides, katas)</option>
                        <option value="hiphop">💃 Hip-hop (mouvements urbains, décontractés)</option>
                        <option value="hyper-artistique">🎨 Hyper artistique (mouvements expressifs, théâtraux)</option>
                        <option value="excentrique">🤪 Complètement excentrique (mouvements imprévisibles, absurdes)</option>
                        <option value="contemporain">🩰 Danse contemporaine (mouvements fluides, abstraits)</option>
                        <option value="robot">🤖 Mouvements saccadés de robot (mécaniques, précis)</option>
                        <option value="custom">✏️ Personnalisé (je décris moi-même)</option>
                    </select>
                </div>
            </div>
            <div class="form-row" id="custom-dance-row" style="display:none;">
                <div style="flex:1 1 100%;">
                    <label for="custom-dance">Décrivez le style de mouvement souhaité</label>
                    <textarea id="custom-dance" placeholder="Ex : Des mouvements lents et majestueux, comme une danse rituelle orientale…"></textarea>
                </div>
            </div>
            <button id="start-btn" class="btn" onclick="startGeneration()">🎬 Créer le film complet (11 clips)</button>
            <div id="error-box" class="error-box"></div>
        </div>
    </div>

    <!-- PHASE 2 -->
    <div id="phase-2" class="panel">
        <div class="panel-title">🎬 Étape 2 — Génération du film</div>

        <div id="bible-panel" class="panel" style="margin-bottom:1rem;">
            <div class="panel-title">📖 Bible du film</div>
            <div id="bible-content"></div>
        </div>

        <div id="scenes-panel" class="panel" style="margin-bottom:1rem;">
            <div class="panel-title">🎞️ Découpage — 11 scènes</div>
            <div id="scenes-content"></div>
        </div>

        <div id="progress-panel" class="panel visible" style="margin-bottom:1rem;">
            <div class="status-line">
                <span class="dot"></span>
                <span id="global-status-text">Initialisation…</span>
                <span id="cooldown-badge" class="cooldown-badge" style="display:none;"></span>
            </div>
            <div id="clips-grid" class="clips-grid"></div>
        </div>

        <div id="gallery-panel" class="panel" style="margin-bottom:1rem;">
            <div class="panel-title" id="gallery-title">✦ Vos clips apparaîtront ici ✦</div>
            <div id="video-grid" class="video-grid"></div>
        </div>

        <button class="btn btn-secondary" onclick="resetToPhase1()" style="width:auto; margin-top:1rem;">← Retour à la configuration</button>
    </div>

    <div id="log-box" class="log-box"></div>

    <div class="history-section">
        <div class="history-title">📚 Historique de vos créations</div>
        <div id="history-container">
            <div class="history-empty" id="history-empty">Aucune vidéo enregistrée pour le moment.</div>
            <div class="history-grid" id="history-grid"></div>
        </div>
    </div>
</div>

<script>
// ==================================================================
// CONFIGURATION
// ==================================================================
const DEFAULT_API_KEY = "sk-DZ8qTzDZ9fWahefwquW7I3a0acKnlVCP7trguNigNJrQgQAL";
const BASE_URL = "https://apihub.agnes-ai.com/v1";
const RAW_URL  = "https://apihub.agnes-ai.com";

const MODELS = { text: "agnes-2.0-flash", video: "agnes-video-v2.0" };

// ── Durées ────────────────────────────────────────────────────────
// 153 frames = 6,375 s à 24 fps → 11 clips ≈ 70 s (1 min 10)
const FILM_NUM_FRAMES = 153;
const FRAME_RATE = 24;

// ── Délais (RPM gratuits : texte 20/min, image 20/min, vidéo 1/min) ─
const FIRST_POLL_DELAY_MS = 60000;
const POLL_INTERVAL_MS = 15000;
const MAX_POLL_ATTEMPTS = 30;
const INTER_VIDEO_DELAY_MS = 65000;
const PRE_VIDEO_DELAY_MS = 65000;

// ── Backoff 429 progressif doux ──────────────────────────────────
const RATE_LIMIT_BACKOFF_SEC = [2, 3, 4, 5, 6, 8, 10, 15];
const MAX_RATE_LIMIT_RETRIES = 8;

// ── Backoff erreurs réseau ───────────────────────────────────────
const NETWORK_ERROR_BACKOFF_SEC = [5, 10, 15, 20, 30, 45, 60];
const MAX_NETWORK_RETRIES = 7;

// ==================================================================
// QUOTA TRACKER (sliding window 60s)
// ==================================================================
const QUOTA_LIMITS = { text: 20, image: 20, video: 1 };
const WINDOW_MS = 60000;

const quotaTracker = {
    text: [],   // timestamps
    image: [],
    video: [],

    record(type) {
        const now = Date.now();
        this[type].push(now);
        this.cleanup();
        this.render();
    },

    cleanup() {
        const cutoff = Date.now() - WINDOW_MS;
        for (const type of ['text', 'image', 'video']) {
            this[type] = this[type].filter(t => t > cutoff);
        }
    },

    canProceed(type) {
        this.cleanup();
        return this[type].length < QUOTA_LIMITS[type];
    },

    waitTime(type) {
        this.cleanup();
        if (this[type].length < QUOTA_LIMITS[type]) return 0;
        const oldest = this[type][0];
        return Math.max(0, Math.ceil((oldest + WINDOW_MS - Date.now()) / 1000));
    },

    render() {
        const renderItem = (type) => {
            const el = document.getElementById(`quota-${type}`);
            const count = this[type].length;
            const limit = QUOTA_LIMITS[type];
            el.textContent = `${count}/${limit}`;
            el.className = 'value ' + (
                count >= limit ? 'danger' :
                count >= limit - 1 ? 'warn' : 'ok'
            );
        };
        renderItem('text');
        renderItem('image');
        renderItem('video');
    }
};

// Tick toutes les secondes pour rafraîchir l'affichage
setInterval(() => quotaTracker.render(), 1000);

// ==================================================================
// STYLES PRÉDÉFINIS (sélectionnables par chips)
// ==================================================================
